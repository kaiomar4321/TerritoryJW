# Copia este archivo a .env y llena los valores de TU proyecto Firebase
# (Firebase Console > Project settings > Your apps > Web app)

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Región inicial del mapa al abrir la app (coordenadas de tu congregación/territorio)
EXPO_PUBLIC_INITIAL_LATITUDE=
EXPO_PUBLIC_INITIAL_LONGITUDE=
EXPO_PUBLIC_INITIAL_LATITUDE_DELTA=0.05
EXPO_PUBLIC_INITIAL_LONGITUDE_DELTA=0.05

# Google Maps API keys (Google Cloud Console), una por plataforma
# iOS y Android NO llevan prefijo EXPO_PUBLIC_ porque solo se usan en build-time
# (app.config.js), no se deben exponer en el bundle de JS.
GOOGLE_MAPS_API_KEY_IOS=
GOOGLE_MAPS_API_KEY_ANDROID=

# Web: esta key SÍ va en el bundle del navegador (es público por diseño), por eso
# lleva EXPO_PUBLIC_ y debe estar restringida por HTTP referrer en Google Cloud
# (Maps JavaScript API). El Map ID es opcional (sin él se usa DEMO_MAP_ID).
EXPO_PUBLIC_GOOGLE_MAPS_WEB_API_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_WEB_MAP_ID=

