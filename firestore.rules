rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && role() in ['admin', 'superadmin'];
    }

    function isSuperAdmin() {
      return isSignedIn() && role() == 'superadmin';
    }

    match /territories/{territoryId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /avoidHouses/{houseId} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSignedIn() &&
        (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    match /users/{userId} {
      // Leer: uno mismo o admin+
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Crear: solo tu propio doc, y siempre con role 'user'
      // (nadie se auto-asigna admin/superadmin al registrarse)
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == 'user';

      // Actualizar tus propios datos, pero sin tocar tu role
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role;

      // Cambiar el role de OTRO usuario: admin solo puede promover a 'admin';
      // superadmin puede asignar cualquier role
      allow update: if isSignedIn() && request.auth.uid != userId && (
        isSuperAdmin() ||
        (role() == 'admin' && request.resource.data.role == 'admin')
      );

      allow delete: if isSuperAdmin();
    }

    match /congregations/{congId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
